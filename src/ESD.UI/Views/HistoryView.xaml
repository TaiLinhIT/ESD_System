<UserControl x:Class="ESD.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="EVENT HISTORY" Style="{StaticResource PageTitle}" Margin="0,0,0,15"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="170"/>
                <DataGridTextColumn Header="STATION" Binding="{Binding StationCode}" Width="90"/>
                <DataGridTextColumn Header="OPERATOR" Binding="{Binding OperatorId}" Width="100"/>
                <DataGridTextColumn Header="FROM" Binding="{Binding OldStatus}" Width="120"/>
                <DataGridTextColumn Header="TO" Binding="{Binding NewStatus}" Width="120"/>
                <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="110"/>
                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
