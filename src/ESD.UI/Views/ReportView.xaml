<UserControl x:Class="ESD.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22">
        <TextBlock Text="REPORT" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource KpiCard}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                <Button Content="EXPORT CSV" Width="140" HorizontalAlignment="Left" Margin="0,20,0,0" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
