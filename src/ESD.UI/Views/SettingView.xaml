<UserControl x:Class="ESD.UI.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="22" Width="600">
        <TextBlock Text="RS485 / SYSTEM SETTINGS" Style="{StaticResource PageTitle}"/>
        <Grid Margin="0,25,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="COM PORT" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding ComPort}" Padding="8"/>
            <TextBlock Grid.Row="1" Text="BAUD RATE" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaudRate}" Padding="8"/>
            <TextBlock Grid.Row="2" Text="PARITY" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Parity}" Padding="8"/>
            <TextBlock Grid.Row="3" Text="STOP BITS" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StopBits}" Padding="8"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="CONNECT" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
            <Button Content="DISCONNECT" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Margin="0,18,0,0" FontWeight="Bold"/>
    </StackPanel>
</UserControl>
