<Window x:Class="ESD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ESD.UI.ViewModels"
        Title="HAN ESD Monitoring System"
        Icon="logo_han.ico"
        Width="1440" Height="880"
        MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!-- HEADER                                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackground}"
                Padding="24,0">

            <DockPanel VerticalAlignment="Center">

                <!-- Logo + Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="36" Height="36" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="HAN ESD MONITORING SYSTEM"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Factory ESD / Wrist Strap Control"
                                   Foreground="#64748B"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right side: status indicators + time + TV button -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <!-- DB Status -->
                    <Border CornerRadius="12" Padding="10,4" Margin="0,0,10,0"
                            Background="#0F2940">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="DbStatusDot" Color="#22C55E"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding DatabaseStatus}"
                                       Foreground="#94A3B8" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- RS485 Status -->
                    <Border CornerRadius="12" Padding="10,4" Margin="0,0,16,0"
                            Background="#0F2940">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#F59E0B"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding CommunicationStatus}"
                                       Foreground="#94A3B8" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Clock -->
                    <TextBlock Text="{Binding CurrentTime}"
                               Foreground="#E2E8F0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- TV Mode Button -->
                    <Button Content="TV MODE"
                            Command="{Binding ToggleTvModeCommand}"
                            Style="{StaticResource HeaderButton}"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!-- BODY                                           -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT NAVIGATION ─── -->
            <Border Grid.Column="0" Background="{StaticResource SideBackground}">
                <DockPanel>

                    <!-- Nav items -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,16,10,0">

                        <Button Content="&#xE80F;  DASHBOARD"
                                Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource NavButton}"/>

                        <Button Content="&#xE81C;  HISTORY"
                                Command="{Binding ShowHistoryCommand}"
                                Style="{StaticResource NavButton}"/>

                        <Button Content="&#xE916;  WORKING TIME"
                                Command="{Binding ShowWorkingTimeCommand}"
                                Style="{StaticResource NavButton}"/>

                        <Button Content="&#xE9D9;  REPORT"
                                Command="{Binding ShowReportCommand}"
                                Style="{StaticResource NavButton}"/>

                        <Separator/>

                        <TextBlock Text="SYSTEM"
                                   Foreground="#334E68"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="14,4,0,6"/>

                        <Button Content="&#xE713;  SETTINGS"
                                Command="{Binding ShowSettingsCommand}"
                                Style="{StaticResource NavButton}"/>

                    </StackPanel>

                    <!-- Bottom status -->
                    <Border DockPanel.Dock="Bottom"
                            Margin="10,0,10,16"
                            Background="#0D1B2A"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding CommunicationStatus}"
                                       Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DatabaseStatus}"
                                       Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>

            <!-- ─── MAIN CONTENT AREA ─── -->
            <Border Grid.Column="1" Padding="0">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>

        </Grid>
    </Grid>
</Window>
