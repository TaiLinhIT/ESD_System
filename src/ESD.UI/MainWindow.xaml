<Window x:Class="ESD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FACTORY - ESD CONTROL"
        Width="1450" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="#063F73">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,16,10,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}"
                                   Foreground="White" FontSize="30" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="FACTORY" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="ESD CONTROL" Foreground="#A9D6F5" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MONITORING" Foreground="#80B8DF" FontSize="10"
                               FontWeight="Bold" Margin="20,12,10,5"/>
                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="30"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="History_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="30"/>
                            <TextBlock Text="Wrist Strap History"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Devices_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE964;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="30"/>
                            <TextBlock Text="Devices / Stations"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SYSTEM" Foreground="#80B8DF" FontSize="10"
                               FontWeight="Bold" Margin="20,22,10,5"/>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="30"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#2B6898" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <Ellipse Width="9" Height="9" Fill="#20D17A" Margin="0,0,8,0"/>
                        <TextBlock Text="System Online" Foreground="#DCEBFA" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#07579A">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="DASHBOARD" Foreground="White"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="PageSubtitle" Text="ESD compliance and wrist strap monitoring"
                                   Foreground="#C9E5F7" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding CurrentDate}" Foreground="White"
                                       FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentTime}" Foreground="White"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Background="#E53935" CornerRadius="5" Padding="11,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}"
                                           Foreground="White" FontSize="19" Margin="0,0,7,0"/>
                                <TextBlock Text="SAFETY FIRST" Foreground="White"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid x:Name="DashboardView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="215"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Compliance Monitoring"
                               FontSize="20" FontWeight="Bold" Foreground="#18324A"
                               Margin="4,0,0,9"/>

                    <!-- KPI -->
                    <UniformGrid Grid.Row="1" Columns="5">
                        <Border Style="{StaticResource Card}" Padding="15,12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#07579A" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Overall Compliance" Foreground="#718096"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ComplianceText}" FontSize="27"
                                           FontWeight="Bold" Foreground="#16A765" Margin="0,7,0,0"/>
                                <TextBlock Text="Based on today's events" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#07579A" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Active Workers" Foreground="#718096"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveWorkers}" FontSize="27"
                                           FontWeight="Bold" Foreground="#18324A" Margin="0,7,0,0"/>
                                <TextBlock Text="Currently monitored" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#16A765" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="OK Events" Foreground="#718096"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding OkCount}" FontSize="27"
                                           FontWeight="Bold" Foreground="#16A765" Margin="0,7,0,0"/>
                                <TextBlock Text="Pass / compliant" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#E53935" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="NG Violations" Foreground="#718096"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NgCount}" FontSize="27"
                                           FontWeight="Bold" Foreground="#E53935" Margin="0,7,0,0"/>
                                <TextBlock Text="Require attention" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#F59E0B" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Stations Online" Foreground="#718096"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectedStationsText}" FontSize="27"
                                           FontWeight="Bold" Foreground="#F59E0B" Margin="0,7,0,0"/>
                                <TextBlock Text="Connected / Total" Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- CHARTS + TABLE -->
                    <Grid Grid.Row="2" Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="205"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Trend -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                        <TextBlock Text="Compliance Trend Over Time" Foreground="White"
                                                   FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Grid Margin="12,12,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{Binding TrendBars}" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="5,0">
                                                        <TextBlock Text="{Binding Value}" FontSize="9"
                                                                   Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <Border Height="{Binding BarHeight}" Width="25"
                                                                Background="#1786C8" CornerRadius="4,4,0,0"
                                                                VerticalAlignment="Bottom" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="9"
                                                                   Foreground="#64748B" HorizontalAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Ellipse Width="9" Height="9" Fill="#16A765" Margin="0,0,6,0"/>
                                                <TextBlock Text="OK" Foreground="#64748B" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Ellipse Width="9" Height="9" Fill="#E53935" Margin="0,0,6,0"/>
                                                <TextBlock Text="NG" Foreground="#64748B" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Donut-style status -->
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                        <TextBlock Text="Station Status Breakdown" Foreground="White"
                                                   FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <Grid Margin="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Stroke="#E53935" StrokeThickness="16"/>
                                            <Ellipse Margin="15" Stroke="#16A765" StrokeThickness="16"
                                                     StrokeDashArray="3,1"/>
                                            <TextBlock Text="{Binding ComplianceText}" FontSize="18"
                                                       FontWeight="Bold" Foreground="#18324A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,5,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <Ellipse Width="10" Height="10" Fill="#16A765" Margin="0,0,7,0"/>
                                                <TextBlock Text="OK / Compliant" Foreground="#475569" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <Ellipse Width="10" Height="10" Fill="#E53935" Margin="0,0,7,0"/>
                                                <TextBlock Text="NG / Violation" Foreground="#475569" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,7,0"/>
                                                <TextBlock Text="Offline" Foreground="#475569" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Recent events -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="5,8,5,5">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Recent Wrist Strap Events" Foreground="White"
                                                   FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EventCountText}"
                                                   Foreground="#D9EEFC" FontSize="10"/>
                                    </Grid>
                                </Border>
                                <DataGrid ItemsSource="{Binding Events}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          RowHeight="34"
                                          Background="White"
                                          Margin="0"
                                          EnableRowVirtualization="True"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                                        <DataGridTextColumn Header="Process / Station" Binding="{Binding Device}" Width="150"/>
                                        <DataGridTextColumn Header="Operator" Binding="{Binding EmployeeId}" Width="*"/>
                                        <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="140"/>
                                        <DataGridTemplateColumn Header="Status" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="8,3"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding Status}" Foreground="White"
                                                                   FontWeight="SemiBold" FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- HISTORY VIEW -->
                <Grid x:Name="HistoryView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4">
                                <TextBlock Text="From Date" FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentDate}" Margin="0,5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4">
                                <TextBlock Text="To Date" FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentDate}" Margin="0,5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4">
                                <TextBlock Text="Process / Station" FontSize="10" Foreground="#64748B"/>
                                <ComboBox Margin="0,4" SelectedIndex="0">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="S3.1"/>
                                    <ComboBoxItem Content="S8.2"/>
                                    <ComboBoxItem Content="S9.1"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4">
                                <TextBlock Text="Operator" FontSize="10" Foreground="#64748B"/>
                                <TextBox Margin="0,4" Height="27" Padding="7,3" Text="Input name or ID"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="4">
                                <TextBlock Text="Result" FontSize="10" Foreground="#64748B"/>
                                <ComboBox Margin="0,4" SelectedIndex="0">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="OK"/>
                                    <ComboBoxItem Content="NG"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Width="125" Height="34" Background="#07579A" Foreground="White"
                                    BorderThickness="0" Click="Search_Click" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,7,0"/>
                                    <TextBlock Text="Search" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="4,0,4,4">
                        <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0"
                                  RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="55"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                                <DataGridTextColumn Header="Process / Station" Binding="{Binding Device}" Width="160"/>
                                <DataGridTextColumn Header="Operator" Binding="{Binding EmployeeId}" Width="*"/>
                                <DataGridTextColumn Header="Old Status" Binding="{Binding OldStatus}" Width="110"/>
                                <DataGridTextColumn Header="New Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTemplateColumn Header="Result" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="9,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding Status}" Foreground="White"
                                                           FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="4,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Text="{Binding EventCountText}" Foreground="#475569" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE892;" FontFamily="{StaticResource IconFont}" Width="42" Margin="3"
                                    ToolTip="First page"/>
                            <Button Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Width="42" Margin="3"
                                    ToolTip="Previous page"/>
                            <Border Background="#07579A" CornerRadius="4" Width="70" Height="34" Margin="3">
                                <TextBlock Text="1 / 125" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                            <Button Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Width="42" Margin="3"
        ToolTip="Next page"/>
                            <Button Content="&#xE893;" FontFamily="{StaticResource IconFont}" Width="42" Margin="3"
        ToolTip="Last page"/>
                            <Button Width="120" Margin="12,3,3,3" Click="Export_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7C5;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Export Excel"/>
                                </StackPanel>
                            </Button>
                            <Button Content="&#xE749;" FontFamily="{StaticResource IconFont}" Width="80" Margin="3"
                                    Click="Print_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- DEVICES -->
                <Grid x:Name="DevicesView" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="4">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                <TextBlock Text="ESD Station / Device Status" Foreground="White"
                                           FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <DataGrid ItemsSource="{Binding Stations}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Station" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="120"/>
                                    <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="130"/>
                                    <DataGridTemplateColumn Header="Connection" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding ConnectionBackground}">
                                                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White"
                                                               FontWeight="SemiBold" FontSize="10"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Last Message" Binding="{Binding LastMessage}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="22" Margin="4">
                        <StackPanel>
                            <TextBlock Text="System Settings" FontSize="20" FontWeight="Bold"
                                       Foreground="#18324A" Margin="0,0,0,18"/>
                            <TextBlock Text="Configuration is loaded from config/appsettings.json."
                                       Foreground="#64748B" Margin="0,0,0,10"/>
                            <TextBlock Text="Database / Device configuration" FontWeight="SemiBold"
                                       Foreground="#07579A"/>
                            <TextBlock Text="{Binding SettingsSummary}" TextWrapping="Wrap"
                                       Foreground="#475569" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#063F73">
                <DockPanel Margin="16,0">
                    <TextBlock Text="SAFETY FIRST – ESD CONTROL" Foreground="#DCEBFA"
                               VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DbQueueText}"
                               Foreground="#DCEBFA" VerticalAlignment="Center" FontSize="10"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
