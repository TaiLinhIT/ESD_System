<Window x:Class="ESD.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAN ESD Monitoring System"
        Icon="logo_han.ico"
        Width="1400" Height="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackground}"
                Padding="24,12">

            <DockPanel>

                <StackPanel DockPanel.Dock="Left">

                    <TextBlock
                        Text="HAN ESD MONITORING SYSTEM"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Factory ESD / Wrist Strap Monitoring"
                        Foreground="#B8C7D9"
                        FontSize="12"/>

                </StackPanel>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="{Binding CurrentTime}"
                        Foreground="White"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"/>

                    <Button
                        Content="TV MODE"
                        Command="{Binding ToggleTvModeCommand}"
                        Style="{StaticResource HeaderButton}"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT MENU -->
            <Border
                Grid.Column="0"
                Background="{StaticResource SideBackground}">

                <StackPanel Margin="12,18">

                    <Button
                        Content="DASHBOARD"
                        Command="{Binding ShowDashboardCommand}"
                        Style="{StaticResource NavButton}"/>

                    <Button
                        Content="HISTORY"
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource NavButton}"/>

                    <Button
                        Content="WORKING TIME"
                        Command="{Binding ShowWorkingTimeCommand}"
                        Style="{StaticResource NavButton}"/>

                    <Button
                        Content="REPORT"
                        Command="{Binding ShowReportCommand}"
                        Style="{StaticResource NavButton}"/>

                    <Button
                        Content="SETTINGS"
                        Command="{Binding ShowSettingsCommand}"
                        Style="{StaticResource NavButton}"/>

                    <Separator Margin="8,18"/>

                    <TextBlock
                        Text="SYSTEM"
                        Foreground="#8392A5"
                        FontSize="11"
                        Margin="12,4"/>

                    <TextBlock
                        Text="{Binding CommunicationStatus}"
                        Foreground="#D7E0EA"
                        Margin="12,6"/>

                    <TextBlock
                        Text="{Binding DatabaseStatus}"
                        Foreground="#D7E0EA"
                        Margin="12,6"/>

                </StackPanel>

            </Border>


            <!-- CONTENT -->
            <ContentControl
                Grid.Column="1"
                Content="{Binding CurrentView}"/>

        </Grid>

    </Grid>

</Window>