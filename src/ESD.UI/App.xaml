<Application x:Class="ESD.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="BlueBrush" Color="#07579A"/>
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#063F73"/>
        <SolidColorBrush x:Key="BlueLightBrush" Color="#EAF4FF"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#18324A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#718096"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#DCE5EF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#16A765"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#64748B"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCEBFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A6CAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#07579A"/>
            <Setter Property="CornerRadius" Value="7,7,0,0"/>
            <Setter Property="Padding" Value="13,9"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FA"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="38"/>
        </Style>
    </Application.Resources>
</Application>
