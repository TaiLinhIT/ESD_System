<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ESD.Web</AssemblyName>
    <RootNamespace>ESD.Web</RootNamespace>
  </PropertyGroup>

  <!--
    The Web UI is intentionally dependency-free:
